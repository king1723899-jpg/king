PORT=3000
HOST=0.0.0.0
NODE_ENV=production
PLATFORM_MODE=b2b

JWT_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret

DEFAULT_LOGIN_USERNAME=kingadmin
DEFAULT_LOGIN_PASSWORD=kingadmin
DEFAULT_REGISTRATION_CODE=KING777WINN
DEFAULT_USER_OPENING_BALANCE=0
ADMIN_INITIAL_BALANCE=10000
# Super Admin is the coin source. When true its balance may go negative;
# the negative amount equals the coins issued into the network.
OWNER_UNLIMITED_COINS=true
# The default login password only seeds a fresh install. Set to true for one
# restart to force-reset the Super Admin password to DEFAULT_LOGIN_PASSWORD.
RESET_SUPER_ADMIN_PASSWORD=false
# Optional absolute path to the SQLite file (defaults to data_store/site.db).
SQLITE_DB_PATH=

DEMO_USERS_COUNT=50
DEMO_INITIAL_BALANCE=500000
DEMO_PASSWORD=demo@123

OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_DISABLE_SERVER_VERIFY=false
SIGNUP_REQUIRE_OTP=false
OTP_REQUIRE_SMS_DELIVERY=false
OTP_DEBUG_INCLUDE_CODE=false

OTP_SMS_PROVIDER=none
OTP_SMS_TEMPLATE=Your OTP for King777 is {otp}.
OTP_SMS_API_URL=
OTP_SMS_API_TOKEN=
OTP_SMS_API_HEADERS_JSON={}

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

MYSQL_SYNC_ENABLED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_mysql_database
MYSQL_POOL_SIZE=5
# Set to 1 only when MYSQL_USER may create databases.
MYSQL_CREATE_DATABASE=0

CASINO_PLAY_URL_TEMPLATE=

API_BODY_LIMIT=2mb
UPLOAD_MAX_FILE_BYTES=2097152
UPLOAD_MAX_FILES=4
UPLOAD_MAX_FIELDS=200
UPLOAD_MAX_FIELD_BYTES=262144

API_MAX_INFLIGHT=800
API_RATE_LIMIT_WINDOW_MS=10000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

SNAPSHOT_CACHE_TTL_MS=5000
CASINO_MERGED_CACHE_TTL_MS=5000
CASINO_HIDE_FAILED_GAMES=true
CASINO_FAILED_GAME_MIN_FAILS=1
CASINO_FAILED_GAME_HIDE_MINUTES=180
CASINO_REQUIRE_WORKING_GAMES=true
CASINO_WORKING_EVIDENCE_MAX_AGE_HOURS=720
DESCENDANT_CACHE_TTL_MS=5000
USER_LIST_CACHE_TTL_MS=3000
SETTINGS_FILE_CACHE_TTL_MS=3000

STATIC_CACHE_SECONDS=86400
SERVER_REQUEST_TIMEOUT_MS=45000
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=70000
SERVER_MAX_REQUESTS_PER_SOCKET=200

# Provider API
PROVIDER_AGENT=MR_Ko3578
PROVIDER_TOKEN=72e53554fbe46f0be77e51451a71c32f73261e477952587e2470b105df4ea3fc
PROVIDER_SECRET=772a385d0636dbc963606729c1a0b75b68777f7b202708c9e2d053d1c71496af
PROVIDER_LAUNCH_API_URL=https://oxentech.asia/api/devtools.php
PROVIDER_AUTH_MODE=agent_sign

# Casino provider wallet callbacks must authenticate (agent+token, API token
# +secret, or bearer). Only if the provider cannot send credentials, list its
# server IPs here (comma separated). Never enable the no-auth flag in production.
PROVIDER_CALLBACK_IPS=
CALLBACK_ALLOW_NO_AUTH_FOR_CALL_PHP=false

# Sports bets are priced from server market data. A market is bettable only if
# a live odds feed set matches.odds_updated_at within this many seconds.
BET_ODDS_MAX_AGE_SECONDS=30
# Testing only: accept bets on prices that no live feed has refreshed.
BET_ALLOW_UNFED_ODDS=false

# Sports commission: % of stake charged when a bet is settled, shared between
# the player's Master (by Master share %) and parent. Taken from winnings on a
# win; on a loss it never pushes the player below zero.
SPORTS_COMMISSION_PERCENT=1
